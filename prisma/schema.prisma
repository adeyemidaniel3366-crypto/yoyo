generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ServiceSlug {
  BILLSTACKS
  BUILDERS
  SPARK
  APARTMENTS
  GALAXY
  VISITORS
}

enum Role {
  SUPER_ADMIN
  SERVICE_MANAGER
  ACCOUNTANT
  CASHIER
  RECEPTION
  STOREKEEPER
  EMPLOYEE
  CUSTOMER
}

// ---------- Platform spine ----------

model Service {
  id        String      @id @default(cuid())
  slug      ServiceSlug @unique
  name      String
  shortName String
  color     String
  isEnabled Boolean     @default(true)
  sortOrder Int
}

model Location {
  id             String              @id @default(cuid())
  name           String
  type           String
  address        String?
  phone          String?
  managerId      String?
  isActive       Boolean             @default(true)
  services       ServiceSlug[]
  stock          StockLevel[]
  sales          Sale[]
  expenses       Expense[]
  transfersOut   StockTransfer[]     @relation("TransferFrom")
  transfersIn    StockTransfer[]     @relation("TransferTo")
  adjustments    StockAdjustment[]
  drawerSessions CashDrawerSession[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model Sequence {
  key       String @id
  lastValue Int    @default(0)
}

// ---------- Auth (NextAuth v5 + Prisma adapter) ----------

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  password          String
  firstName         String
  lastName          String
  phone             String?
  avatar            String?
  roles             Role[]
  serviceAccess     ServiceSlug[]
  locationIds       String[]
  notificationPrefs Json?
  mustChangePass    Boolean        @default(false)
  emailVerified     DateTime?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  sessions          Session[]
  accounts          Account[]
  activity          ActivityLog[]
  notifications     Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  remember     Boolean  @default(false)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Shared engines ----------

model Contact {
  id         String        @id @default(cuid())
  name       String
  phone      String?       @unique
  email      String?       @unique
  address    String?
  types      ContactType[]
  sources    ServiceSlug[]
  locationId String?
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  invoices   Invoice[]
  payments   Payment[]
  sales      Sale[]
  bookings   Booking[]
  orders     Order[]
  visits     Visit[]
  employee   Employee?
}

enum ContactType {
  CUSTOMER
  SUPPLIER
  GUEST
  VISITOR
  EMPLOYEE
  AFFILIATE
}

model Category {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String?
  image       String?
  parentId    String?
  parent      Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]  @relation("CategoryHierarchy")
  source      ServiceSlug
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  products    Product[]
}

model Brand {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  logo        String?
  description String?
  source      ServiceSlug
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  products    Product[]
}

model Product {
  id              String                @id @default(cuid())
  sku             String                @unique
  slug            String                @unique
  name            String
  description     String?               @db.Text
  categoryId      String?
  category        Category?             @relation(fields: [categoryId], references: [id])
  brandId         String?
  brand           Brand?                @relation(fields: [brandId], references: [id])
  source          ServiceSlug
  unit            String
  costKobo        Int                   @default(0)
  priceKobo       Int
  salePriceKobo   Int?
  saleStart       DateTime?
  saleEnd         DateTime?
  taxRatePct      Decimal               @default(0) @db.Decimal(5, 2)
  lowStockAt      Int                   @default(5)
  images          String[]
  specifications  Json?
  status          ProductStatus         @default(ACTIVE)
  isFeatured      Boolean               @default(false)
  isNew           Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  stock           StockLevel[]
  variants        ProductVariant[]
  saleItems       SaleItem[]
  invoiceItems    InvoiceItem[]
  orderItems      OrderItem[]
  reviews         Review[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  compareItems    CompareItem[]
  purchaseItems   PurchaseItem[]
  transferItems   StockTransferItem[]
  adjustmentItems StockAdjustmentItem[]
  sheetItems      StockSheetItem[]
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  sku        String      @unique
  priceKobo  Int
  stockQty   Int         @default(0)
  images     String[]
  attributes Json
  isActive   Boolean     @default(true)
  cartItems  CartItem[]
  orderItems OrderItem[]
}

model StockLevel {
  id                  String    @id @default(cuid())
  productId           String
  product             Product   @relation(fields: [productId], references: [id])
  locationId          String
  location            Location  @relation(fields: [locationId], references: [id])
  qty                 Decimal   @db.Decimal(10, 2)
  lastLowStockAlertAt DateTime?
  updatedAt           DateTime  @updatedAt

  @@unique([productId, locationId])
}

model Sale {
  id            String      @id @default(cuid())
  source        ServiceSlug
  locationId    String
  location      Location    @relation(fields: [locationId], references: [id])
  receiptNo     String
  contactId     String?
  contact       Contact?    @relation(fields: [contactId], references: [id])
  items         SaleItem[]
  subtotalKobo  Int
  discountKobo  Int         @default(0)
  taxKobo       Int         @default(0)
  totalKobo     Int
  paidKobo      Int
  status        SaleStatus  @default(PAID)
  fulfilment    String?
  paymentMethod String?
  soldById      String
  remarks       String?
  isParked      Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@unique([source, locationId, receiptNo])
  @@index([source, createdAt])
  @@index([locationId, createdAt])
  @@index([contactId, createdAt])
}

enum SaleStatus {
  PAID
  PART_PAID
  UNPAID
  RETURNED
  VOID
}

model SaleItem {
  id            String  @id @default(cuid())
  saleId        String
  sale          Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  qty           Decimal @db.Decimal(10, 2)
  unitPriceKobo Int
  totalKobo     Int
}

model Invoice {
  id           String            @id @default(cuid())
  source       ServiceSlug
  invoiceNo    String
  contactId    String
  contact      Contact           @relation(fields: [contactId], references: [id])
  items        InvoiceItem[]
  payments     Payment[]
  subtotalKobo Int
  discountKobo Int               @default(0)
  taxKobo      Int               @default(0)
  totalKobo    Int
  status       InvoiceStatus     @default(DRAFT)
  dueDate      DateTime?
  isRecurring  Boolean           @default(false)
  recurringId  String?
  recurring    RecurringInvoice? @relation(fields: [recurringId], references: [id])
  paymentRef   String?
  sentAt       DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([source, invoiceNo])
  @@index([source, createdAt])
  @@index([contactId, createdAt])
  @@index([status])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PART_PAID
  OVERDUE
  CANCELLED
}

model InvoiceItem {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id])
  description   String
  qty           Decimal  @db.Decimal(10, 2)
  unitPriceKobo Int
  totalKobo     Int
}

model RecurringInvoice {
  id        String      @id @default(cuid())
  source    ServiceSlug
  contactId String
  template  Json
  frequency String
  nextRunAt DateTime
  isActive  Boolean     @default(true)
  invoices  Invoice[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Estimate {
  id                 String         @id @default(cuid())
  source             ServiceSlug
  estimateNo         String
  contactId          String
  items              Json
  subtotalKobo       Int
  taxKobo            Int            @default(0)
  totalKobo          Int
  status             EstimateStatus @default(DRAFT)
  validUntil         DateTime?
  convertedInvoiceId String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([source, estimateNo])
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
}

model Payment {
  id           String        @id @default(cuid())
  source       ServiceSlug
  contactId    String
  contact      Contact       @relation(fields: [contactId], references: [id])
  invoiceId    String?
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id])
  bookingId    String?
  booking      Booking?      @relation(fields: [bookingId], references: [id])
  orderId      String?
  order        Order?        @relation(fields: [orderId], references: [id])
  amountKobo   Int
  method       String
  reference    String?       @unique
  gateway      String?
  gatewayRef   String?       @unique
  status       PaymentStatus @default(PAID)
  receivedById String
  note         String?
  date         DateTime      @default(now())
  createdAt    DateTime      @default(now())

  @@index([source, createdAt])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIAL
}

model Expense {
  id          String      @id @default(cuid())
  source      ServiceSlug
  locationId  String?
  location    Location?   @relation(fields: [locationId], references: [id])
  category    String
  amountKobo  Int
  paidTo      String?
  receiptUrl  String?
  note        String?
  createdById String
  date        DateTime    @default(now())
  createdAt   DateTime    @default(now())

  @@index([source, createdAt])
  @@index([locationId, createdAt])
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  source     ServiceSlug
  poNo       String
  contactId  String
  items      PurchaseItem[]
  totalKobo  Int
  status     PurchaseOrderStatus @default(DRAFT)
  expectedAt DateTime?
  note       String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([source, poNo])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  PARTIAL
  CANCELLED
}

model PurchaseItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  qty             Decimal       @db.Decimal(10, 2)
  receivedQty     Decimal       @default(0) @db.Decimal(10, 2)
  unitCostKobo    Int
  totalKobo       Int
}

// ---------- Stock operations ----------

model StockTransfer {
  id            String              @id @default(cuid())
  source        ServiceSlug
  fromId        String
  from          Location            @relation("TransferFrom", fields: [fromId], references: [id])
  toId          String
  to            Location            @relation("TransferTo", fields: [toId], references: [id])
  items         StockTransferItem[]
  status        TransferStatus      @default(REQUESTED)
  requestedById String
  receivedById  String?
  note          String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

enum TransferStatus {
  REQUESTED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id])
  qty        Decimal       @db.Decimal(10, 2)
}

model StockAdjustment {
  id          String                @id @default(cuid())
  source      ServiceSlug
  locationId  String
  location    Location              @relation(fields: [locationId], references: [id])
  reason      String
  items       StockAdjustmentItem[]
  createdById String
  note        String?
  createdAt   DateTime              @default(now())
}

model StockAdjustmentItem {
  id           String          @id @default(cuid())
  adjustmentId String
  adjustment   StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  qtyChange    Decimal         @db.Decimal(10, 2)
}

model StockMovement {
  id         String   @id @default(cuid())
  productId  String
  locationId String
  qtyChange  Decimal  @db.Decimal(10, 2)
  reason     String
  refType    String
  refId      String
  actorId    String
  createdAt  DateTime @default(now())

  @@index([productId, locationId, createdAt])
}

model StockSheet {
  id        String           @id @default(cuid())
  source    ServiceSlug      @default(BUILDERS)
  sheetNo   String           @unique
  date      DateTime         @db.Date
  countedBy String
  items     StockSheetItem[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model StockSheetItem {
  id           String     @id @default(cuid())
  stockSheetId String
  stockSheet   StockSheet @relation(fields: [stockSheetId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  itemNo       Int
  openingQty   Decimal    @db.Decimal(10, 2)
  outQty       Decimal    @default(0) @db.Decimal(10, 2)
  inQty        Decimal    @default(0) @db.Decimal(10, 2)
  closingQty   Decimal    @db.Decimal(10, 2)
}

model CashDrawerSession {
  id           String      @id @default(cuid())
  source       ServiceSlug
  locationId   String
  location     Location    @relation(fields: [locationId], references: [id])
  openedById   String
  closedById   String?
  openedAt     DateTime    @default(now())
  closedAt     DateTime?
  openingKobo  Int
  expectedKobo Int?
  countedKobo  Int?
  varianceKobo Int?
  status       String      @default("OPEN")

  @@index([locationId, openedAt])
}

// ---------- Apartments ----------

model RoomType {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  description   String    @db.Text
  basePriceKobo Int
  taxPct        Decimal   @default(10) @db.Decimal(5, 2)
  adults        Int
  children      Int
  checkIn       String    @default("23:00")
  checkOut      String    @default("10:00")
  cancellation  String    @default("Free Cancellation")
  images        String[]
  amenities     String[]
  facilities    String[]
  bedType       String    @default("6x6")
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  rooms         Room[]
  bookings      Booking[]
}

model Room {
  id         String     @id @default(cuid())
  roomTypeId String
  roomType   RoomType   @relation(fields: [roomTypeId], references: [id])
  number     String     @unique
  floor      Int?
  status     RoomStatus @default(AVAILABLE)
  bookings   Booking[]

  @@index([status])
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
  OUT_OF_ORDER
}

model Booking {
  id              String        @id @default(cuid())
  ref             String        @unique
  source          ServiceSlug   @default(APARTMENTS)
  contactId       String
  contact         Contact       @relation(fields: [contactId], references: [id])
  roomTypeId      String
  roomType        RoomType      @relation(fields: [roomTypeId], references: [id])
  roomId          String?
  room            Room?         @relation(fields: [roomId], references: [id])
  checkIn         DateTime      @db.Date
  checkOut        DateTime      @db.Date
  adults          Int
  children        Int
  rooms           Int           @default(1)
  totalKobo       Int
  taxKobo         Int
  status          BookingStatus @default(REQUESTED)
  specialRequests String?
  holdExpiresAt   DateTime?
  checkedInAt     DateTime?
  checkedOutAt    DateTime?
  lateCheckIn     Boolean       @default(false)
  delayedCheckOut Boolean       @default(false)
  payments        Payment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([source, createdAt])
  @@index([contactId, createdAt])
  @@index([status])
  @@index([checkIn, checkOut])
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

// ---------- Galaxy ----------

model Order {
  id              String        @id @default(cuid())
  orderNo         String        @unique
  source          ServiceSlug   @default(GALAXY)
  contactId       String
  contact         Contact       @relation(fields: [contactId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  shippingAddress Json
  billingAddress  Json?
  subtotalKobo    Int
  taxKobo         Int
  shippingKobo    Int           @default(0)
  discountKobo    Int           @default(0)
  totalKobo       Int
  couponId        String?
  coupon          Coupon?       @relation(fields: [couponId], references: [id])
  notes           String?
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([source, createdAt])
  @@index([contactId, createdAt])
  @@index([status])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  productName String
  productSku  String
  priceKobo   Int
  qty         Int
  totalKobo   Int
}

model Coupon {
  id           String      @id @default(cuid())
  code         String      @unique
  source       ServiceSlug @default(GALAXY)
  discountPct  Decimal?    @db.Decimal(5, 2)
  discountKobo Int?
  minSpendKobo Int?
  maxUses      Int?
  usedCount    Int         @default(0)
  validFrom    DateTime?
  validUntil   DateTime?
  isActive     Boolean     @default(true)
  orders       Order[]
}

model Review {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  contactId          String
  rating             Int
  title              String?
  comment            String   @db.Text
  isVerifiedPurchase Boolean  @default(false)
  isApproved         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([productId, isApproved])
}

model CartItem {
  id        String          @id @default(cuid())
  contactId String
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  qty       Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([contactId, productId, variantId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  contactId String
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([contactId, productId])
}

model CompareItem {
  id        String   @id @default(cuid())
  contactId String
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([contactId, productId])
}

// ---------- Visitors ----------

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  employees Employee[]
}

model Designation {
  id        String     @id @default(cuid())
  name      String     @unique
  employees Employee[]
}

model Employee {
  id            String         @id @default(cuid())
  contactId     String         @unique
  contact       Contact        @relation(fields: [contactId], references: [id])
  departmentId  String?
  department    Department?    @relation(fields: [departmentId], references: [id])
  designationId String?
  designation   Designation?   @relation(fields: [designationId], references: [id])
  isActive      Boolean        @default(true)
  attendances   Attendance[]
  hostedVisits  Visit[]        @relation("Host")
  leaveRequests LeaveRequest[]
}

model LeaveRequest {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  type        String
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  reason      String?
  status      String   @default("PENDING")
  decidedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Visit {
  id            String       @id @default(cuid())
  source        ServiceSlug  @default(VISITORS)
  contactId     String
  contact       Contact      @relation(fields: [contactId], references: [id])
  hostId        String?
  host          Employee?    @relation("Host", fields: [hostId], references: [id])
  purpose       String?
  checkInAt     DateTime?
  checkOutAt    DateTime?
  status        VisitStatus  @default(EXPECTED)
  preRegisterId String?
  preRegister   PreRegister? @relation(fields: [preRegisterId], references: [id])
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())

  @@index([source, createdAt])
  @@index([contactId, createdAt])
  @@index([status])
}

enum VisitStatus {
  EXPECTED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  EXPIRED
}

model PreRegister {
  id           String      @id @default(cuid())
  source       ServiceSlug @default(VISITORS)
  contactId    String
  hostId       String?
  visitDate    DateTime    @db.Date
  visitTime    String?
  purpose      String?
  inviteToken  String      @unique
  inviteSentAt DateTime?
  status       VisitStatus @default(EXPECTED)
  visits       Visit[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Attendance {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  date       DateTime  @db.Date
  clockInAt  DateTime?
  clockOutAt DateTime?
  status     String    @default("PRESENT")

  @@unique([employeeId, date])
}

// ---------- Content ----------

model BlogPost {
  id            String      @id @default(cuid())
  slug          String      @unique
  source        ServiceSlug
  title         String
  excerpt       String
  content       String      @db.Text
  featuredImage String?
  authorId      String
  tags          String[]
  status        String      @default("DRAFT")
  publishedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model FAQ {
  id        String      @id @default(cuid())
  source    ServiceSlug
  question  String
  answer    String      @db.Text
  category  String?
  sortOrder Int         @default(0)
  isActive  Boolean     @default(true)
}

model ContactMessage {
  id        String      @id @default(cuid())
  source    ServiceSlug
  name      String
  email     String
  subject   String
  message   String      @db.Text
  isRead    Boolean     @default(false)
  createdAt DateTime    @default(now())
}

model NewsletterSubscriber {
  id        String      @id @default(cuid())
  source    ServiceSlug
  email     String
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  @@unique([source, email])
}

// ---------- Platform ----------

model ActivityLog {
  id         String      @id @default(cuid())
  source     ServiceSlug
  locationId String?
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  summary    String
  amountKobo Int?
  createdAt  DateTime    @default(now())

  @@index([source, createdAt])
  @@index([actorId, createdAt])
}

model Notification {
  id         String      @id @default(cuid())
  source     ServiceSlug
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  body       String
  entityType String?
  entityId   String?
  channel    String      @default("IN_APP")
  isRead     Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([userId, isRead, createdAt])
  @@index([source, createdAt])
}

model NotificationTemplate {
  id        String      @id @default(cuid())
  source    ServiceSlug
  event     String
  channel   String
  subject   String?
  body      String      @db.Text
  variables String[]
  isActive  Boolean     @default(true)
  updatedAt DateTime    @updatedAt

  @@unique([source, event, channel])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  gateway     String
  eventId     String    @unique
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

model IdempotencyKey {
  key         String   @id
  requestHash String
  response    Json
  createdAt   DateTime @default(now())
  expiresAt   DateTime
}

model PlatformSetting {
  key   String @id
  value Json
}
