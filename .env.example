# Database
DATABASE_URL="postgresql://user:pass@host:5432/zino_one?sslmode=require&connection_limit=10"
DIRECT_URL="postgresql://user:pass@host:5432/zino_one?sslmode=require"
DATABASE_URL_TEST="postgresql://user:pass@host:5432/zino_one_test?sslmode=disable"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="<openssl rand -base64 32>"
DEMO_LOGINS="true"                 # demo role buttons; MUST be "false" in production

# Platform
NEXT_PUBLIC_PLATFORM_NAME="Zino One"
APP_TIMEZONE="Africa/Lagos"

# Payments (sandbox keys in dev; live keys only in production)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET_HASH=""
STRIPE_SECRET_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
PAYMENT_GATEWAY_DEFAULT="PAYSTACK"

# Email (SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Zino One <no-reply@zinoone.com>"

# SMS (optional; notifications skip SMS silently when unset)
TERMII_API_KEY=""
TERMII_SENDER_ID="ZinoOne"

# Uploads (S3-compatible; local public/uploads when unset)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_URL=""

# Cron + rate limiting
CRON_SECRET="<openssl rand -hex 16>"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Business defaults
DEFAULT_TAX_PCT="7.5"
APARTMENTS_TAX_PCT="10"
LOW_STOCK_DEFAULT="5"
LARGE_SALE_ALERT_KOBO="50000000"   # ₦500,000 — notify manager above this
ALLOW_SEED_RESET="false"
